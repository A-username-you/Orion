{
  "package": {
    "productName": "Orion Indicator",
    "version": "0.1.0"
  },
  "build": {
    "beforeDevCommand": "cargo dev",
    "beforeBuildCommand": "cargo build",
    "devPath": "http://localhost:1420",
    "distDir": "../svelte"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.orion.indicator",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [ {
      "fullscreen": false,
      "resizable": true,
      "title": "Orion Indicator",
      "width": 800,
      "height": 600
    } ],
    "macOSPrivateApi": true,
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  }
}